
# Local application database
DATABASE_URL=postgresql+psycopg://expensehub_user:replace_me@localhost:5432/expense_tracker

# Dedicated test database — never use production credentials here
TEST_DATABASE_URL=postgresql+psycopg://expensehub_test_user:replace_me@localhost:5432/expense_tracker_test

# JWT signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Compose PostgreSQL initialization
POSTGRES_USER=expensehub_user
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=expense_tracker
